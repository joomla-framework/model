{
    "name": "joomla/model",
    "type": "joomla-package",
    "description": "Joomla Model Package",
    "keywords": ["joomla", "framework", "model"],
    "homepage": "https://github.com/joomla-framework/model",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": "^8.3.0"
    },
    "require-dev": {
        "joomla/database": "^4.0",
        "joomla/registry": "^4.0",
        "phpunit/phpunit": "^12.2.7",
        "squizlabs/php_codesniffer": "^3.7.2",
        "phpstan/phpstan": "^2.1.17",
        "phpstan/phpstan-deprecation-rules": "^2.0.3"
    },
    "suggest": {
        "joomla/database": "^4.0 Allows using database models",
        "joomla/registry": "^4.0 Allows using stateful models"
    },
    "autoload": {
        "psr-4": {
            "Joomla\\Model\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Joomla\\Model\\Tests\\": "Tests/"
        }
    },
    "minimum-stability": "dev"
}
